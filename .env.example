# Copier ce fichier en .env.local et remplir les deux valeurs.
# Ce fichier n'est JAMAIS commité (.gitignore) et aucune de ces
# variables n'est exposée au navigateur (pas de préfixe NEXT_PUBLIC_).

# Chaîne de connexion PostgreSQL de la base Neon
# (Neon → projet → Connect → « Connection string », pooler recommandé).
# Sert à la fois à l'app (Prisma) et à la CLI Prisma (prisma.config.ts).
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Clé de signature du cookie de session (32+ caractères aléatoires) :
#   openssl rand -base64 32
AUTH_SECRET=
