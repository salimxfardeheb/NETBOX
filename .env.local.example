# Copier ce fichier en .env.local et remplir les deux valeurs
# depuis le dashboard Supabase → Settings → API.
# Ne JAMAIS mettre la clé service_role ici : ces variables sont
# exposées au navigateur (préfixe NEXT_PUBLIC_).

# La clé publique du projet : nouvelle clé sb_publishable_... dans
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY, ou clé anon legacy dans
# NEXT_PUBLIC_SUPABASE_ANON_KEY — une seule des deux suffit.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
